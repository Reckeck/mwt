{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeApp",
  "version": "0.1.0",
  "identifier": "dev.tradeapp.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TradeApp",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Finance",
    "shortDescription": "Encrypted finance & crypto portfolio manager",
    "longDescription": "TradeApp — offline-first encrypted transactions, portfolio, prices and strategy simulation.",
    "icon": ["icons/icon.png"]
  }
}