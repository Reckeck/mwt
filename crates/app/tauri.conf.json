{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi Wallet Tracker Dev",
  "mainBinaryName": "multi-wallet-tracker-dev",
  "version": "0.1.0",
  "identifier": "dev.mwt.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Multi Wallet Tracker",
        "width": 1320,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MWT",
    "homepage": "https://gitlab.com/Reckeck/trade-app",
    "license": "MIT",
    "category": "Finance",
    "shortDescription": "Encrypted finance & crypto portfolio manager",
    "longDescription": "Multi Wallet Tracker (MWT) — offline-first encrypted transactions, portfolio, prices and charts.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "en-US",
          "ru-RU"
        ],
        "fragmentPaths": [
          "windows/autostart-cleanup.wxs"
        ],
        "componentGroupRefs": [
          "MwtAutostartCleanup"
        ]
      }
    },
    "linux": {
      "deb": {
        "postRemoveScript": "../../packaging/linux/postrm.sh"
      },
      "rpm": {
        "postRemoveScript": "../../packaging/linux/postrm.sh"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
