{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeApp",
  "version": "0.1.0",
  "identifier": "dev.tradeapp.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TradeApp",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TradeApp",
    "homepage": "https://gitlab.com/Reckeck/trade-app",
    "license": "MIT",
    "category": "Finance",
    "shortDescription": "Encrypted finance & crypto portfolio manager",
    "longDescription": "TradeApp — offline-first encrypted transactions, portfolio, prices and charts.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["en-US", "ru-RU"]
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}