{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi Wallet Tracker Dev",
  "mainBinaryName": "multi-wallet-tracker-dev",
  "version": "0.1.0",
  "identifier": "dev.mwt.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Multi Wallet Tracker",
        "width": 1320,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "ipc: http://ipc.localhost ws: http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0MTQ5NDczNkZFRDdENUYKUldSZmZlMXZjNVFVMUEwcDJiVU5BbzdGanV2SitYYTdYZ1grSkNyS2t1aTZYRHAzck5RVFFkOVcK",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MWT",
    "homepage": "https://github.com/Reckeck/mwt",
    "license": "MIT",
    "category": "Finance",
    "shortDescription": "Encrypted finance & crypto portfolio manager",
    "longDescription": "Multi Wallet Tracker (MWT) — offline-first encrypted transactions, portfolio, prices and charts.",
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico",
      "icons/dev/icon.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "en-US",
          "ru-RU"
        ],
        "fragmentPaths": [
          "windows/autostart-cleanup.wxs"
        ],
        "componentGroupRefs": [
          "MwtAutostartCleanup"
        ]
      }
    },
    "linux": {
      "deb": {
        "postRemoveScript": "../../packaging/linux/postrm.sh"
      },
      "rpm": {
        "postRemoveScript": "../../packaging/linux/postrm.sh"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
